{
  "name": "@forge/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Forge backend service — onchain job indexer + REST API for the Arc-testnet marketplace.",
  "scripts": {
    "dev": "tsx watch src/indexer/main.ts",
    "start": "node --import tsx/esm src/indexer/main.ts",
    "api:dev": "tsx watch src/api/main.ts",
    "api:start": "node --import tsx/esm src/api/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "viem": "^2.49.3",
    "drizzle-orm": "^0.36.0",
    "postgres": "^3.4.4",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0"
  }
}
