# Forge backend — example env. Copy to .env and fill in real values.
# The .env file itself is gitignored (see root /.gitignore).

# Postgres connection string. For local dev:
#   createdb forge_indexer
#   DATABASE_URL=postgresql://localhost:5432/forge_indexer
# For production (Phase E): Railway/Supabase/Neon will provide a string.
DATABASE_URL=postgresql://localhost:5432/forge_indexer

# Arc testnet RPC. Default matches frontend/lib/chains.ts.
ARC_RPC_URL=https://rpc.testnet.arc.network

# Block at which JobEscrow was deployed — first block we ever scan.
# Source: deploy tx 0x1657773c…ad7ad8bd mined in this block.
# See contracts/script/DeployJobEscrow.s.sol output for the canonical value.
START_BLOCK=42728020

# How often the indexer polls for new blocks (milliseconds). Arc blocks
# every ~1-2s, so 5s gives ~2-5 blocks per tick. Lower = lower latency,
# higher RPC load. Phase C will use this for the loop's setInterval.
POLL_INTERVAL_MS=5000

# Maximum RPC requests per second the indexer will emit. Arc public RPC
# is throttled at ~100 req/sec; we default to 30 to leave wide headroom
# under viem's internal retries. Set to a high value (e.g. 1000) to
# effectively disable when running against a private RPC with no cap.
MAX_RPC_REQS_PER_SEC=30

# Port the Hono API listens on (Phase D). 3001 keeps it out of
# the frontend's localhost:3000.
PORT=3001

# ─────────────────────────────────────────────────────────────────
# Neon-specific note: when using Neon Postgres in production, the
# compute auto-pauses after ~5 minutes of idle. The first query after
# wake-up may fail with ECONNRESET; the indexer detects this as a
# TransientConnectionError and retries with exponential backoff (see
# src/indexer/errors.ts). No manual intervention required.
# ─────────────────────────────────────────────────────────────────
